# Copie para .env (install.sh faz isso automaticamente se .env não existir).
# STORAGE_BACKEND=local é o padrão -- a app roda inteira sem nenhuma
# credencial AWS: sessões/usuários/histórico de scan em local_data/*.json,
# reset de senha loga o link em vez de enviar email, RAG semântico e
# métricas CloudWatch ficam desativados (ver docstrings de rag.py/metrics.py).

# ==================== Storage ====================
# "local" (padrão, sem AWS) ou "aws" (produção -- DynamoDB/S3/SES/CloudWatch/Bedrock)
STORAGE_BACKEND=local

# Onde local_store.py grava sessions.json/users.json/password_resets.json/
# scan_history/ quando STORAGE_BACKEND=local. Padrão: ./local_data
# LOCAL_DATA_DIR=./local_data

# ==================== Só usados quando STORAGE_BACKEND=aws ====================
# AWS_DEFAULT_REGION=us-east-2
# DB_S3_BUCKET=security-scanner-db-442042548551
# SESSIONS_DYNAMO_TABLE=security-scanner-sessions
# USERS_DYNAMO_TABLE=security-scanner-users
# PASSWORD_RESETS_DYNAMO_TABLE=security-scanner-password-resets
# RAG_KNOWLEDGE_TABLE=security-scanner-knowledge
# SES_SENDER_EMAIL=no-reply@example.com
# APP_BASE_URL=https://scanner.example.com

# ==================== IA — Claude (Anthropic) ====================
# Obrigatório para /ai/ask (ai_analyzer.py). Sem isso, a app roda normalmente,
# só o endpoint de IA fica indisponível.
ANTHROPIC_API_KEY=

# ==================== Outras opções ====================
# Domínios permitidos no cadastro (vazio = qualquer domínio)
# ALLOWED_REGISTRATION_DOMAINS=

# Origens permitidas por CORS (vazio = padrão do código)
# CORS_ORIGINS=

# Rate limiting: se Redis não estiver acessível, cai para memória por
# worker automaticamente (não bloqueia o boot) -- opcional em local.
# REDIS_URL=redis://localhost:6379

# Usado só por cve_updater.py (atualização semanal do cache de CVEs de K8s)
# NVD_API_KEY=

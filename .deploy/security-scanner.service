[Unit]
Description=Security Multicloud Scanner API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/security-scanner
Environment="PATH=/home/ubuntu/security-scanner/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="AWS_DEFAULT_REGION=us-east-2"
Environment="DB_S3_BUCKET=security-scanner-db-442042548551"
EnvironmentFile=/home/ubuntu/security-scanner/.env
ExecStart=/home/ubuntu/security-scanner/venv/bin/uvicorn api_with_mfa:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/security-scanner/logs/api.log
StandardError=append:/home/ubuntu/security-scanner/logs/api.log

[Install]
WantedBy=multi-user.target
